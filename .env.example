# NotiPoli - Environment Variables
# Copy this file to .env and fill in the values

# ============================================
# GENERAL
# ============================================
NODE_ENV=production

# ============================================
# DATABASE (PostgreSQL)
# ============================================
# Generate a secure password: openssl rand -base64 32
DB_PASSWORD=changeme_secure_password_here

# DATABASE_URL is constructed in docker-compose.yml:
# postgresql://notipoli:${DB_PASSWORD}@postgres:5432/notipoli?schema=public

# ============================================
# AUTHENTICATION (JWT)
# ============================================
# Generate secrets: openssl rand -base64 64
JWT_SECRET=changeme_jwt_secret_at_least_32_chars_long
JWT_REFRESH_SECRET=changeme_refresh_secret_different_from_above
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# BACKEND
# ============================================
PORT=3000
FRONTEND_URL=http://localhost
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=10485760
LOG_LEVEL=info

# ============================================
# FRONTEND (Vite)
# ============================================
# These are used at build time in the frontend container
# VITE_API_URL=http://localhost/api
# VITE_APP_NAME=NotiPoli