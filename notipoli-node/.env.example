# NotiPoli Backend - Environment Variables
# Copy to .env for local development

# App
NODE_ENV=development
PORT=3000

# Database (local PostgreSQL or Docker)
# For local: postgresql://postgres:password@localhost:5432/notipoli
# For Docker: postgresql://notipoli:password@postgres:5432/notipoli
DATABASE_URL=postgresql://notipoli:changeme@localhost:5432/notipoli?schema=public

# Auth
JWT_SECRET=dev_jwt_secret_change_in_production_min_32_chars
JWT_REFRESH_SECRET=dev_refresh_secret_change_in_production_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Logging
LOG_LEVEL=debug